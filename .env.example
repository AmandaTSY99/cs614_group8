# Environment variables template for CS614 Group 8 (4 Financial RAG Systems)
# Copy this file to .env and insert your credentials (never commit .env to git)

# 1. Shared Supabase Cloud Database (95,044 SEC 10-K chunks + 272 XBRL rows)
SUPABASE_DB_URL=postgresql://postgres.jfhpjggjoabgpoxwezuc:[YOUR_SUPABASE_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 2. Active LLM Provider & Model ("openai" | "groq" | "gemini" | "ollama" | "mock")
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4

# 3. Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# 4. RQ2 RAGAS Evaluation Judge Configuration
EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=gpt-4o-mini
